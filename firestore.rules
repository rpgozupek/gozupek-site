rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcı profil verileri — sadece kendi dökümanına erişim
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /devices/{deviceId} {

      // ESP32: sahipsiz cihazı kayıt edebilir (auth yok, claimed=false zorunlu)
      allow create: if !request.resource.data.keys().hasAll(['ownerUid'])
                    && request.resource.data.claimed == false;

      // Oturum açmış kullanıcı kendi cihazını okuyabilir
      // ESP32 kendi cihazını okuyabilir (auth yok, sadece okuma)
      allow read: if request.auth == null           // ESP32 polling
                  || (request.auth != null
                      && resource.data.ownerUid == request.auth.uid);

      // Kullanıcı sahipsiz cihazı sahiplenebilir
      allow update: if request.auth != null
                    && (
                      // Sahipleme: cihaz daha önce sahipsizdi
                      (resource.data.claimed == false
                       && request.resource.data.ownerUid == request.auth.uid)
                      ||
                      // Kendi cihazını güncelleme (toggle / silme)
                      resource.data.ownerUid == request.auth.uid
                    );
    }
  }
}
